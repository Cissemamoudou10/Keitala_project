# Environnement (dev, test, prod)
ENV=dev
DEBUG=true

# Sécurité
SECRET_KEY=changez_cette_cle_secrete_en_production_tres_longue_et_aleatoire
ALGORITHM=HS256
# Jeton d'accès court, renouvelé par le jeton de rafraîchissement (US-AUTH-01)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de données PostgreSQL (asyncpg pour SQLAlchemy)
# Port 5433 en développement local Docker
DATABASE_URL=postgresql+asyncpg://keitala_user:keitala_dev_password@localhost:5433/keitala_db

# Base de données de test
TEST_DATABASE_URL=postgresql+asyncpg://keitala_user:keitala_dev_password@localhost:5433/keitala_test_db

# CORS (origines autorisées)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# En-tête des factures (US-VTE-03) : provisoire tant que le client ne les a pas fournies (P-006)
# Valeurs FICTIVES d'exemple : à remplacer par celles du client
ENTREPRISE_NOM=Keitala SARL
ENTREPRISE_ADRESSE=Rue 312, Porte 45, Hamdallaye ACI 2000, Bamako, Mali
ENTREPRISE_TELEPHONE=20220000
ENTREPRISE_IDENTIFIANTS=NIF : 000000000X · RCCM : MA.BKO.2026.B.0000
ENTREPRISE_MENTIONS=Merci de votre confiance.
