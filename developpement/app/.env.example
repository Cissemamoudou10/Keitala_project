# Adresse de l'API FastAPI, lue côté serveur uniquement par le proxy /api.
# Ne jamais la préfixer par NEXT_PUBLIC_ : le navigateur ne doit pas la connaître.
API_URL=http://localhost:8000

# Parcours de bout en bout (Playwright) : mot de passe des comptes de test
# e2e-*@keitala.test, créés par `python -m app.commandes.comptes_e2e` (API, ENV=dev).
# Valeur de test, sans usage hors développement et CI.
E2E_MOT_DE_PASSE=e2e-b8cVG2UxJWmNkFDP

# Production seulement (Vercel) : secret partagé avec le reverse proxy du VPS, qui refuse
# toute requête vers l'API sans l'en-tête x-cle-proxy (D-037). Ne pas définir en local.
# API_CLE_PROXY=
